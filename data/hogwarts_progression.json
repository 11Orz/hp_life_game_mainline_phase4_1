    "gradeThresholds": {
      "O": 90,
      "E": 75,
      "A": 60,
      "P": 45,
      "D": 25,
      "T": 0
    },
    "scoreFormula": "clamp(round(subjectSkill*0.55 + examReadiness*0.25 + knowledge*0.15 + random(-10,10) - stress*0.05),0,100)",
    "warning": "所有数值、分数线和随机机制均为游戏原创，绝非官方设定",
