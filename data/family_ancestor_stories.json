        "all": [
          "secret_investigation_complete",
          "secret:secret_001:evidence_at_least_3"
        ]
      },
      "estimated_minutes": 30,
      "chapters": [
        {
          "id": "story_001_ch1",
          "title": "意外的线索",
          "summary": "玩家得到一条年代模糊的历史线索",
          "choice_ids": [
            "story_001_ch1_a",
            "story_001_ch1_b"
          ],
          "scene": "在图书馆的地方史索引里，你发现一条被墨迹遮去的姓名。边缘批注写着：名字被抹去，不代表此人从未存在。",
          "choices": [
            {
              "id": "story_001_ch1_a",
              "label": "谨慎记录证据",
              "effects": {
                "research": 2,
                "integrity": 1
              }
            },
            {
              "id": "story_001_ch1_b",
              "label": "大胆追查传闻",
              "effects": {
                "research": 1,
                "integrity": -1
              }
            }
          ]
        },
        {
          "id": "story_001_ch2",
          "title": "交叉核对",
          "summary": "访问记录与不同证人，识别矛盾",
          "choice_ids": [
            "story_001_ch2_a",
            "story_001_ch2_b"
          ],
          "scene": "你将残页与旧登记簿比对，发现两处日期互相矛盾。有人刻意误导调查者，也可能只是抄写错误。",
