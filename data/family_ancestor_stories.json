            {
              "id": "story_001_ch2_a",
              "label": "核对不同来源",
              "effects": {
                "research": 2,
                "integrity": 1
              }
            },
            {
              "id": "story_001_ch2_b",
              "label": "依赖单一证词",
              "effects": {
                "research": 1,
                "integrity": -1
              }
            }
          ]
        },
        {
          "id": "story_001_ch3",
          "title": "旧日的抉择",
          "summary": "理解历史人物当年的处境与代价",
          "choice_ids": [
            "story_001_ch3_a",
            "story_001_ch3_b"
          ],
          "scene": "一封私人信件揭示，当事人曾在家族忠诚与保护友人之间犹豫。记录者并不可靠。",
          "choices": [
            {
              "id": "story_001_ch3_a",
              "label": "听取多方叙述",
              "effects": {
                "research": 2,
                "integrity": 1
              }
            },
            {
              "id": "story_001_ch3_b",
              "label": "相信未经证实的说法",
              "effects": {
                "research": 1,
                "integrity": -1
              }
            }
          ]
        },
        {
          "id": "story_001_ch4",
          "title": "归档与传承",
          "summary": "确定哪些结论有证据，哪些仍是猜测",
          "choice_ids": [
            "story_001_ch4_a",
            "story_001_ch4_b"
          ],
          "scene": "你需要决定如何整理证据：公布可核实的事实，还是保留尚无依据的猜想。",
          "choices": [
            {
              "id": "story_001_ch4_a",
              "label": "如实归档",
              "effects": {
                "research": 2,
                "integrity": 1
              }
            },
            {
              "id": "story_001_ch4_b",
              "label": "公开推测",
              "effects": {
                "research": 1,
                "integrity": -1
              }
            }
          ]
        }
      ],
      "endings": [
        {
          "id": "documented",
          "condition": "evidence_verified",
          "effect": "archive_story"
        },
        {
          "id": "inconclusive",
          "condition": "evidence_insufficient",
          "effect": "mark_unresolved"
        },
        {
          "id": "debunked",
          "condition": "evidence_disproves",
          "effect": "correct_family_tree"
        }
      ],
      "reward": {
        "knowledge": 2,
        "heirloom_item_id": null,
        "magic_power": 0
      },
      "replayable": true,
      "optional": true,
      "source_disclaimer": "原创调查剧情；发现与正史家族相关的史料，不代表玩家与该家族存在血缘。"
